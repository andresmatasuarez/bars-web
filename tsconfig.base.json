{
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Vite 8 declares its types only in package.json "exports", which "Node"
    // resolution ignores; TypeScript would then fall back to other copies.
    "moduleResolution": "bundler",
    "target": "es5",
    "module": "es2022",
    "lib": ["es2017", "dom"],
    "types": ["vite/client", "node", "vitest/globals"],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "exclude": ["build", "node_modules"]
}
